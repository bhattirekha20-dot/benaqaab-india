# ═══════════════════════════════════════════════
# Benaqaab India — Central Private Vault .gitignore
# ═══════════════════════════════════════════════

# ─── Temporary / Extraction caches ────────────
_temp_extract/
.cache/
tmp/
temp/

# ─── Rendered videos & audio (too large / private for Git) ───
VIDEOS/*.mp4
projects/**/*.mp4
*.mp4
*.mp3
*.wav
*.m4a
projects/**/vo/
vo/
projects/voter_list_sir/comp.html

# Whitelist essential lightweight project audio and retrieval audit logs
!projects/india_last_24h/*.mp3
!projects/india_last_24h/video_assets/*.log
!projects/india_japan_jcm/*.mp3
!projects/world_news_24h/*.mp3
!projects/world_news_24h/delivery/*.srt
!projects/world_news_24h/delivery/*.txt
!projects/world_news_24h/delivery/qa/*.log
!projects/world_news_24h/delivery/qa/*.json

# ─── Private user uploads & phone screenshots ─
uploads/
uploads/*

# ─── Environment variables & secrets ──────────
.env
.env.*
*.local
*.pem
*.key
*.pfx
secrets.json
credentials.json
token.json
*.id_rsa
*.id_ed25519

# ─── OS / System files ───────────────────────
Thumbs.db
Desktop.ini
.DS_Store
$RECYCLE.BIN/

# ─── Node / JS ───────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*

# ─── Python ──────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
*.egg-info/
dist/
build/

# ─── IDE / Editor configurations ─────────────
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo

# ─── Logs ────────────────────────────────────
*.log
!projects/india_last_24h/video_assets/*.log
